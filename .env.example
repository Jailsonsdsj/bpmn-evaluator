# Anthropic API key — obtain at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Claude model used by all three agents
MODEL_NAME=claude-sonnet-4-20250514

# Maximum number of Reflection loop iterations for Agent 2
MAX_ITERATIONS=3

# Minimum average confidence required before Agent 2 stops iterating; items below this threshold get flag_review=True
CONFIDENCE_THRESHOLD=0.6
