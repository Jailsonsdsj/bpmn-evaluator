# Which LLM provider every agent uses. One of:
#   anthropic | google_genai | openai | groq | mistralai | ollama
# (any provider supported by langchain.init_chat_model works if its package is installed).
LLM_PROVIDER=anthropic

# Model id for the selected provider (e.g. claude-sonnet-4-6, gemini-2.0-flash, gpt-4o).
MODEL_NAME=claude-sonnet-4-6

# Set the API key that matches LLM_PROVIDER (leave the others unset).
ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
# GROQ_API_KEY=...
# MISTRAL_API_KEY=...

# --- Local / self-hosted models ---------------------------------------------
# Ollama (local, default host) — `pip install langchain-ollama`, then:
#   LLM_PROVIDER=ollama
#   MODEL_NAME=llama3.1
# Ollama on another host (or from inside Docker):
#   LLM_BASE_URL=http://host.docker.internal:11434
#
# OpenAI-compatible server (LM Studio / llama.cpp / vLLM / text-generation-webui):
#   LLM_PROVIDER=openai
#   MODEL_NAME=<model id the server exposes>
#   LLM_BASE_URL=http://localhost:1234/v1
#   OPENAI_API_KEY=not-needed   # required to be non-empty; the local server ignores it
# LLM_BASE_URL=

MAX_ITERATIONS=3
CONFIDENCE_THRESHOLD=0.6
